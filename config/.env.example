# ============================================================
# 拾物集 SHIWU · 环境配置示例
# 用法：cp config/.env.example config/.env  然后按需修改
# 该文件位于 public/ 之外，不会被 HTTP 访问；请勿提交到代码仓库
# ============================================================

# ---------- 运行环境 ----------
SHOP_ENV=production
# 数据库文件（留空 = 项目 data/shop.sqlite）
# SHOP_DB_PATH=/var/lib/shiwu/shop.sqlite
# 站点对外地址（强烈建议设置，用于生成支付回调地址，防 Host 头伪造）
SHOP_BASE_URL=https://shop.example.com

# ---------- 易支付（EPay 通用协议） ----------
# 总开关：填好下面 3 项后再改成 true
EPAY_ENABLED=false
# 商户 ID（易支付后台 PID）
EPAY_PID=
# 商户密钥（易支付后台 KEY）—— 只用于签名/验签，绝不外泄
EPAY_KEY=
# 支付网关提交地址，例如 https://pay.xxx.com/submit.php
# 也可写成 EPAY_GATEWAY_URL，两者等价
EPAY_GATEWAY=
# EPAY_GATEWAY_URL=https://pay.xxx.com/submit.php
# 签名算法，通用协议默认 MD5
EPAY_SIGN_TYPE=MD5
# 可用渠道：本站只支持微信支付与支付宝，其他通道会被服务端拒绝
# 别名 wechat 等价于 wxpay
EPAY_CHANNELS=wxpay,alipay
# 回调地址（留空按 SHOP_BASE_URL 自动拼接）
# EPAY_NOTIFY_URL=https://shop.example.com/api/pay/notify
# EPAY_RETURN_URL=https://shop.example.com/pay-result.html
# 金额校验容差（分）。默认 0 = 必须完全相等，不建议调大
EPAY_AMOUNT_TOLERANCE_CENTS=0
# 未支付订单自动关单（分钟）
EPAY_EXPIRE_MINUTES=120

# ---------- 后台管理 ----------
# 初始管理员：仅在第一次执行 php bin/init_db.php 时创建
SHOP_ADMIN_USER=admin
# 请改成强密码（至少 10 位）。留空则 init_db 会随机生成并打印一次
SHOP_ADMIN_PASSWORD=
# 会话空闲超时 / 绝对超时（秒）
SHOP_ADMIN_IDLE_TIMEOUT=7200
SHOP_ADMIN_ABSOLUTE_TIMEOUT=43200
# 后台 IP 白名单（逗号分隔 IP 或 CIDR，留空不限制）
# SHOP_ADMIN_IP_ALLOWLIST=203.0.113.10,10.0.0.0/8

# ---------- 跨域（同源部署留空） ----------
# SHOP_ALLOWED_ORIGINS=https://shop.example.com
